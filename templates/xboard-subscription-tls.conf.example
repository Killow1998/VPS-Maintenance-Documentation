# Include in http context. Only the stream ingress should reach this listener.
server {
    listen 127.0.0.1:9443 ssl;
    server_name subscription.example.invalid;
    ssl_certificate /etc/letsencrypt/live/subscription.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/subscription.example.invalid/privkey.pem;
    access_log off;
    add_header Cache-Control "private, no-store" always;
    location = /api/v1/client/subscribe {
        limit_except GET { deny all; }
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:7001;
    }
    location / { return 404; }
}
