@@ -1231,6 +1231,17 @@ func parseClaudeUsageNode(usageNode gjson.Result) usage.Detail {
 		CacheReadTokens:     cacheReadTokens,
 		CacheCreationTokens: cacheCreationTokens,
 	}
+	five := usageNode.Get("cache_creation.ephemeral_5m_input_tokens")
+	hour := usageNode.Get("cache_creation.ephemeral_1h_input_tokens")
+	if five.Type == gjson.Number && hour.Type == gjson.Number &&
+		five.Float() == float64(five.Int()) && hour.Float() == float64(hour.Int()) &&
+		five.Int() >= 0 && hour.Int() >= 0 && five.Int() <= cacheCreationTokens &&
+		hour.Int() == cacheCreationTokens-five.Int() {
+		detail.CacheCreation = &usage.CacheCreationUsage{
+			Ephemeral5mInputTokens: five.Int(),
+			Ephemeral1hInputTokens: hour.Int(),
+		}
+	}
