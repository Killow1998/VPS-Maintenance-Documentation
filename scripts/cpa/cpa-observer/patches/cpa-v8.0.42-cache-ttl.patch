@@ -0,0 +1,39 @@
+package helps
+
+import "testing"
+
+func TestClaudeCacheTTLUsageAndStreamMerge(t *testing.T) {
+	start := []byte(`{"type":"message_start","message":{"usage":{"input_tokens":60,"cache_read_input_tokens":30,"cache_creation_input_tokens":10,"output_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":3,"ephemeral_1h_input_tokens":7}}}}`)
+	initial, ok := ParseClaudeStreamUsage(start)
+	if !ok || initial.CacheCreation == nil {
+		t.Fatal("missing initial cache TTL buckets")
+	}
+	end, ok := ParseClaudeStreamUsage([]byte(`{"type":"message_delta","usage":{"output_tokens":30}}`))
+	merged := MergeStreamUsageDetail(initial, end)
+	if !ok || merged.CacheCreation == nil || merged.CacheCreation.Ephemeral5mInputTokens != 3 ||
+		merged.CacheCreation.Ephemeral1hInputTokens != 7 || merged.CacheCreationTokens != 10 {
+		t.Fatalf("lost TTL buckets on output-only delta: %+v", merged)
+	}
+	if !merged.TokenBreakdown.Valid() || merged.TokenBreakdown.TotalTokens != 130 {
+		t.Fatalf("token accounting changed: %+v", merged.TokenBreakdown)
+	}
+}
+
+func TestClaudeCacheTTLRejectsMissingOrInconsistentBuckets(t *testing.T) {
+	for _, creation := range []string{
+		`{}`, `{"ephemeral_5m_input_tokens":10}`,
+		`{"ephemeral_5m_input_tokens":3,"ephemeral_1h_input_tokens":8}`,
+		`{"ephemeral_5m_input_tokens":-1,"ephemeral_1h_input_tokens":11}`,
+		`{"ephemeral_5m_input_tokens":3.5,"ephemeral_1h_input_tokens":6.5}`,
+		`{"ephemeral_5m_input_tokens":"3","ephemeral_1h_input_tokens":7}`,
+	} {
+		payload := []byte(`{"usage":{"input_tokens":60,"cache_creation_input_tokens":10,"output_tokens":30,"cache_creation":` + creation + `}}`)
+		if detail := ParseClaudeUsage(payload); detail.CacheCreation != nil {
+			t.Fatalf("accepted ambiguous TTL buckets: %s", creation)
+		}
+	}
+	detail := ParseClaudeUsage([]byte(`{"usage":{"input_tokens":60,"output_tokens":30,"cache_creation_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0}}}`))
+	if detail.CacheCreation == nil || detail.CacheCreation.Ephemeral1hInputTokens != 0 {
+		t.Fatal("explicit zero must remain distinguishable from missing data")
+	}
+}
