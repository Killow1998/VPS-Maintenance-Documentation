+package redisqueue
+
+import (
+	"context"
+	"testing"
+
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+)
+
+func TestQueueRetainsCacheTTLUsage(t *testing.T) {
+	withEnabledQueue(t, func() {
+		plugin := &usageQueuePlugin{}
+		plugin.HandleUsage(context.Background(), coreusage.Record{
+			Provider: "claude", Model: "synthetic-model",
+			Detail: coreusage.Detail{
+				InputTokens: 60, OutputTokens: 30, CacheReadTokens: 30, CacheCreationTokens: 10,
+				TotalTokens: 130,
+				CacheCreation: &coreusage.CacheCreationUsage{Ephemeral5mInputTokens: 3, Ephemeral1hInputTokens: 7},
+			},
+		})
+		payload := popSinglePayload(t)
+		tokens := payload["tokens"].(map[string]any)
+		creation := tokens["cache_creation"].(map[string]any)
+		if creation["ephemeral_5m_input_tokens"] != float64(3) || creation["ephemeral_1h_input_tokens"] != float64(7) {
+			t.Fatalf("TTL buckets changed in queue: %+v", creation)
+		}
+		plugin.HandleUsage(context.Background(), coreusage.Record{Provider: "claude"})
+		tokens = popSinglePayload(t)["tokens"].(map[string]any)
+		if _, exists := tokens["cache_creation"]; exists {
+			t.Fatal("missing TTL data became a zero-valued bucket")
+		}
+	})
+}
